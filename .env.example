# Optional for reading official sources: set the CAADoc root for the selected release.
# Index-only queries work without this file. Preserve any existing .env values.
# Keep .env for R21. Copy this template separately to .env.r33 for R33.
CAA_CAADOC_ROOT=<caadoc-root>

# Optional path overrides. The default database is the R21 index.
# CAA_AI_MANUAL_ROOT=<project-root>
# CAA_AI_MANUAL_DB=<project-root>/data/manual.sqlite
# In .env.r33 only: uncomment this database and set an R33 CAADoc root above.
# Use --env-file .env.r33 before the CLI subcommand. Do not replace the R21 .env.
# CAA_AI_MANUAL_DB=<project-root>/data/r33/manual.sqlite
