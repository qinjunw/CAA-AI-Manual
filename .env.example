# Optional for reading official sources: copy to .env and set the CAADoc root.
# Index-only queries work without this file. Preserve any existing .env values.
CAA_CAADOC_ROOT=<caadoc-root>

# Optional path overrides. The defaults use this project and data/manual.sqlite.
# CAA_AI_MANUAL_ROOT=<project-root>
# CAA_AI_MANUAL_DB=<project-root>/data/manual.sqlite
