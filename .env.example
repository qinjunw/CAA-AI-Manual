# Optional source profile for CLI, MCP and full builds.
# Copy to .env.r21 or .env.r33 and set the matching CAADoc directory.
# The default release also accepts an existing .env when its named profile is absent.
CAA_CAADOC_ROOT=<caadoc-root>

# Optional overrides for custom queries without --release:
# CAA_AI_MANUAL_ROOT=<project-root>
# CAA_AI_MANUAL_DB=<absolute-path-to-custom-index>
